// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores user login info and connects their financial data
model User {
  id          String  @id @default(uuid())
  clerkUserId String  @unique
  email       String  @unique
  firstName   String?
  lastName    String?

  accounts      Account[] //user can have many accounts
  categories    Category[] //user can have many categories
  incomeSources IncomeSource[] //user can have many income sources
  transactions  Transaction[] //user can have many transactions
  budgets       Budget[] //user can have a budget per category per month
  budgetPlans   BudgetPlan[] //50/30/20 split, from a month on
  paySchedules  PaySchedule[] //when and how much each income source pays

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Transaction Table
model Transaction {
  id     String          @id @default(uuid())
  type   TransactionType
  amount Decimal         @db.Decimal(12, 2) // always positive; type gives the direction
  date   DateTime        @db.Date // calendar date only, no time/timezone
  notes  String?

  // Owner of the transaction; deleting the user deletes their transactions
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // NoAction: you can't delete an account/category that still has
  // transactions (we archive those instead)
  account   Account @relation(fields: [accountId], references: [id], onDelete: NoAction)
  accountId String // Foreign key

  // Required for INCOME and EXPENSE (enforced by a CHECK in the database);
  // adjustments have none
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  categoryId String?

  // Who paid you (only for INCOME transactions, optional)
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: NoAction)
  incomeSourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([incomeSourceId])
}

// Bank Account
model Account {
  id             String        @id @default(uuid())
  name           String
  type           AccountType
  // Balance when added to the app; the current balance is calculated
  // from transactions so it can never drift
  // Negative means money owed (e.g. a credit card balance)
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  // The day the opening balance was true; transactions count from this date
  openingDate    DateTime      @db.Date
  archivedAt     DateTime?
  transactions   Transaction[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Stores default and user-created categories used to organize transactions
model Category {
  id         String        @id @default(uuid())
  name       String
  emoji      String? // optional, stored separately from the name
  group      CategoryGroup
  archivedAt DateTime? // archived categories are hidden but keep their history

  transactions Transaction[]
  budgets      Budget[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name]) // no duplicate category names per user
}

// How much you plan to spend in one category in one month.
// Removing a budget deletes the row, so amount is always more than 0.
model Budget {
  id     String   @id @default(uuid())
  month  DateTime @db.Date // always the 1st of the month, e.g. 2026-11-01
  amount Decimal  @db.Decimal(12, 2)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month]) // one budget per category per month
}

// Who pays the user (e.g. each employer), separate from the income category
model IncomeSource {
  id         String    @id @default(uuid())
  name       String
  emoji      String?
  archivedAt DateTime?

  transactions Transaction[]
  paySchedules PaySchedule[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum AccountType {
  CHEQUING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
}

// Defines whether money is coming in, going out, or moving between accounts
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT // corrects a balance to match the bank; amount can be negative
}

// Budget group for a category (50/30/20 rule); income is its own group
// SAVINGS, DEBT and INVESTMENTS together make up the "20%" in 50/30/20
enum CategoryGroup {
  NEEDS
  WANTS
  SAVINGS
  DEBT
  INVESTMENTS
  INCOME
}

// The 50/30/20 split, starting from a month. A month uses the latest plan
// from that month or earlier, so a plan carries forward until it's changed
// (and changing it never alters earlier months). The money it splits is the
// month's expected income, from pay schedules.
model BudgetPlan {
  id         String   @id @default(uuid())
  month      DateTime @db.Date // the month it starts from, always the 1st
  needsPct   Int      @default(50)
  wantsPct   Int      @default(30)
  savingsPct Int      @default(20) // Savings, Debt and Investments together

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month]) // one plan per starting month
}

// How often a pay schedule pays
enum PayFrequency {
  WEEKS // every `interval` weeks, e.g. 2 = every two weeks
  MONTHS // every `interval` months, on the first payday's day
  TWICE_A_MONTH // on dayOne and dayTwo each month
}

// What an income source pays and when, from its first payday on. A payday
// uses the latest schedule that started on or before it, unless that one has
// ended, so a raise or a new frequency mid-month is counted exactly and past
// paydays never change. Expected income for a month = the paydays in it.
model PaySchedule {
  id        String       @id @default(uuid())
  startsOn  DateTime     @db.Date // first payday at this amount
  endsOn    DateTime?    @db.Date // last payday, e.g. when leaving a job
  amount    Decimal      @db.Decimal(12, 2) // per paycheque
  frequency PayFrequency
  interval  Int? // weeks (1-52) or months (1-12); empty for twice a month
  dayOne    Int? // twice a month only, e.g. 1
  dayTwo    Int? // twice a month only, e.g. 15 (31 = last day of the month)

  incomeSource   IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  incomeSourceId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([incomeSourceId, startsOn]) // one schedule per start date per source
}
